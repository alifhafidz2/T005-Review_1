<odoo>
    <data>
        <record id="create_attendee_wizard_action" model="ir.actions.act_window">
            <field name="name">Add Attendee</field>
            <field name="res_model">academic.create.attendee.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <record id="create_attendee_form_view" model="ir.ui.view">
            <field name="name">academic.create.attendee.wizard.form</field>
            <field name="model">academic.create.attendee.wizard</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Add Attendee">
                    <group>
                        <field name="session_id"/>
                        <field name="partner_ids"/>
                    </group>
                    <footer>
                        <button type="special" special="cancel" string="Cancel" icon="fa-times"/>
                        <button type="object" name="action_add_attendee" string="Add Attendee" icon="fa-check-circle" confirm="Are you sure you want to add those attendee?"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="open_wizard_action_server" model="ir.actions.server">
            <field name="name">Add Attendees</field>
            <field name="model_id" ref="academic.model_academic_session"/>
            <field name="binding_model_id" ref="academic.model_academic_session"/>
            <field name="binding_view_types">list,form</field>
            <field name="state">code</field>
            <field name="code">
                if records:
                    action = records.open_wizard()
            </field>
        </record>

        <menuitem id="create_attendee_wizard_menu"
            name="Add Attendee"
            parent="academic_1"
            action="create_attendee_wizard_action"
            sequence="40"/>
    </data>
</odoo>