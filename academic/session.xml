<odoo>
    <data>

        <!-- Session Tree View -->
        <record id="view_academic_session_tree" model="ir.ui.view">
            <field name="name">academic.session.tree</field>
            <field name="model">academic.session</field>
            <field name="type">tree</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <tree string="Session"
                    decoration-danger="taken_seats &gt; 50"
                    decoration-success="taken_seats &lt; 20">
                    <field name="name"/>
                    <field name="instructor_id"/>
                    <field name="start_date"/>
                    <field name="duration"/>
                    <field name="seats"/>
                    <field name="taken_seats" widget="progressbar"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <!-- Session Form View -->
        <record id="view_academic_session_form" model="ir.ui.view">
            <field name="name">academic.session.form</field>
            <field name="model">academic.session</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Session">
                    <header>
                        <button string="Confirm" type="object" name="action_confirmed" states="draft"/>
                        <button string="Mark as Done" type="object" name="action_done" states="confirmed"/>
                        <button string="Reset to Draft" type="object" name="action_draft" states="confirmed,done"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <!-- Kolom kiri-->
                        <group>
                            <field name="course_id"/>
                            <field name="instructor_id" domain="['|','|',('is_instructor', '=', True),('category_id','=','Instruktur'),('category_id','=','Trainer')]"/>
                            <field name="start_date"/>
                            <field name="image_small" widget="image" class="oe_avatar oe_left"/>
                        </group>
                        <!-- Kolom kanan-->
                        <group>
                            <field name="duration"/>
                            <field name="seats"/>
                            <field name="taken_seats" widget="progressbar"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Attendees">
                            <field name="attendee_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="session_id"/>
                                    <field name="partner_id"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </form>
            </field>
        </record>

        <!-- Calendar View -->
        <record id="session_cal" model="ir.ui.view">
            <field name="name">session_cal</field>
            <field name="model">academic.session</field>
            <field name="arch" type="xml">
                <calendar string="Session" date_start="start_date" color="course_id">
                    <field name="name"/>
                </calendar>
            </field>
        </record>

        <!-- Search View -->
        <record id="session_search" model="ir.ui.view">
            <field name="name">session_search</field>
            <field name="model">academic.session</field>
            <field name="arch" type="xml">
                <search string="Search Session">
                    <filter string="Non Zero Duration" name="non_zero" domain="[('duration','>',0)]"/>
                    <field name="name"/>
                    <field name="instructor_id"/>
                    <group string="Group By...">
                        <filter name="course_search" string="Course" domain="[]" context="{'group_by':'course_id'}"/>
                        <filter name="instructor_search" string="Instructor" domain="[]" context="{'group_by':'instructor_id'}"/>
                        <filter name="date_search" string="Date" domain="[]" context="{'group_by':'start_date'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Graph View -->
        <record id="session_graph" model="ir.ui.view">
            <field name="name">session_graph</field>
            <field name="model">academic.session</field>
            <field name="arch" type="xml">
                <graph string="Session" type="bar">
                    <field name="instructor_id"/>
                    <field name="seats" operator="+"/>
                </graph>
            </field>
        </record>

        <!-- Kanban View -->
        <record id="session_kanban" model="ir.ui.view">
            <field name="name">session_kanban</field>
            <field name="model">academic.session</field>
            <field name="arch" type="xml">
                <kanban default_group_by="course_id">
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_vignette">
                                <a type="open">
                                    <img t-att-src="kanban_image('academic.session','image_small',record.id)" t-att-title="record.id" t-att-alt="record.id" class="o_kanban_image"/>
                                </a>
                                <div class="oe_kanban_details">
                                    <h4>
                                        <a type="open">
                                            <field name="name"/>
                                        </a>
                                    </h4>
                                    <ul>
                                        <li>
                                            Seats: <field name="seats"/>
                                        </li>
                                        <li>
                                            Taken Seats: <field name="taken_seats"/>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

    </data>
</odoo>