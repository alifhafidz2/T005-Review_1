<odoo>
    <data>
        <record id="email_notif_post" model="mail.template">
            <field name="name">Invoice Post Email</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="subject">{{object.name}}</field>
            <field name="email_from">{{(object.user_id.email)}}</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="description">Invoice Post Notification</field>
            <field name="body_html" type="html">
                <div>
                    Hello, <span t-field="object.partner_id.name"/>!
                    <br/>
                    Your invoice <span t-field="object.name"/> has been posted.
                    <br/>
                    Admin Team
                </div>
            </field>
        </record>
    </data>
</odoo>